# Optional configuration for Whatnot AI Game Overlay.
# Copy to ".env" next to this file. NEVER commit a real .env.
#
# Credentials are best entered in the dashboard (Settings -> Credentials or the
# first-run wizard): they are then stored in the Windows Credential Manager.
# Environment variables, if set, take precedence over stored credentials.
#
# ANTHROPIC_API_KEY=
# PRICECHARTING_TOKEN=
# OBS_PASSWORD=

# production | development | test
WGO_ENV=production

# Local address. Keep 127.0.0.1 — the dashboard must not be exposed to the network.
WGO_HOST=127.0.0.1
WGO_PORT=8765

# Where the database, logs and dashboard token live (default: %LOCALAPPDATA%\WhatnotGameOverlay)
# WGO_DATA_DIR=

# DEBUG | INFO | WARNING | ERROR
WGO_LOG_LEVEL=INFO

# Demo mode with mock camera/APIs (prefer Start-Demo.cmd, which also uses port 8766)
WGO_DEMO=false
